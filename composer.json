{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "signals/ui-dense",
    "description": "Domain-neutral dense UI primitives for data-dense applications.",
    "type": "library",
    "license": "AGPL-3.0-only",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/view": "^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ui\\Dense\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ui\\Dense\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --parallel"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ui\\Dense\\DenseServiceProvider"
            ]
        }
    }
}
